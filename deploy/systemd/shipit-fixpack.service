[Unit]
Description=ShipIt paid Fix Pack processor
After=network-online.target shipit.service
Wants=network-online.target
Requires=shipit.service
OnFailure=shipit-alert@%n.service

[Service]
Type=oneshot
User=shipit-ops
WorkingDirectory=/opt/shipit
EnvironmentFile=/opt/shipit/.env
Environment=SHIPIT_INTERNAL_BASE_URL=http://127.0.0.1:8000
# One bounded processor invocation handles at most one paid job. A verified
# build makes two sequential runner requests: original and patched, each with
# a 960-second transport budget. Add 120 seconds for repository fetch, planning,
# comparison, persistence and delivery around those runner calls.
ExecStart=/opt/shipit/deploy/scripts/call-internal-endpoint.sh /internal/fixpack/process-paid FIXPACK_PROCESS_TOKEN 2040
# A SIGTERM is not a failure here. These units Require=shipit.service, so
# restarting the API -- every deploy does -- stops them too, and a run that
# happens to be in flight is killed mid-curl. The work is idempotent and the
# timer fires again within minutes, but systemd counted it as a failed unit
# and OnFailure= paged the operator about a deploy they had just triggered.
# A real kill is SIGKILL (9, an OOM), which still fails and still alerts.
SuccessExitStatus=SIGTERM
# Keep systemd outside curl's complete request budget. The extra 120 seconds
# lets curl report and exit cleanly instead of systemd killing it at the same
# instant as its own deadline.
TimeoutStartSec=2160
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
LockPersonality=true
StandardOutput=journal
StandardError=journal
