[Unit]
Description=ShipIt paid Fix Pack processor
After=network-online.target shipit.service
Wants=network-online.target
Requires=shipit.service
OnFailure=shipit-alert@%n.service

[Service]
Type=oneshot
User=shipit-ops
WorkingDirectory=/opt/shipit
EnvironmentFile=/opt/shipit/.env
Environment=SHIPIT_INTERNAL_BASE_URL=http://127.0.0.1:8000
ExecStart=/opt/shipit/deploy/scripts/call-internal-endpoint.sh /internal/fixpack/process-paid FIXPACK_PROCESS_TOKEN 1200
# A SIGTERM is not a failure here. These units Require=shipit.service, so
# restarting the API -- every deploy does -- stops them too, and a run that
# happens to be in flight is killed mid-curl. The work is idempotent and the
# timer fires again within minutes, but systemd counted it as a failed unit
# and OnFailure= paged the operator about a deploy they had just triggered.
# A real kill is SIGKILL (9, an OOM), which still fails and still alerts.
SuccessExitStatus=SIGTERM
TimeoutStartSec=1200
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
LockPersonality=true
StandardOutput=journal
StandardError=journal
