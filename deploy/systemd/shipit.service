[Unit]
Description=ShipIt API (Drydock)
After=network-online.target
Wants=network-online.target
OnFailure=shipit-alert@%n.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=shipit
WorkingDirectory=/srv/shipit/current
Environment=ENVIRONMENT=production

ExecStartPre=/usr/bin/test -x /srv/shipit/current/.venv/bin/python
ExecStartPre=/srv/shipit/current/.venv/bin/python /srv/shipit/current/deploy/scripts/validate-production-env.py --env-file /opt/shipit/.env
ExecStart=/srv/shipit/current/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2

Restart=on-failure
RestartSec=3

# Hardening (same profile as timer services — reap, fixpack, monitoring, etc.)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
LockPersonality=true

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
