[Unit]
Description=ShipIt off-site backup retention and repository check
After=network-online.target shipit-db-offsite-backup.service
Wants=network-online.target
OnFailure=shipit-alert@%n.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/shipit
Environment=RESTIC_ENV_FILE=/etc/shipit/restic.env
Environment=RESTIC_KEEP_LAST=3
Environment=RESTIC_KEEP_DAILY=14
Environment=RESTIC_KEEP_WEEKLY=8
Environment=RESTIC_KEEP_MONTHLY=12
ExecStart=/opt/shipit/deploy/scripts/maintain-postgres-offsite.sh
TimeoutStartSec=7200
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

ReadOnlyPaths=/etc/shipit
ReadWritePaths=/var/cache/shipit-restic
ReadWritePaths=/run/lock
