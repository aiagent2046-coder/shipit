[Unit]
Description=Send ShipIt operator alert for failed unit %i

[Service]
Type=oneshot
User=shipit-ops
WorkingDirectory=/opt/shipit
EnvironmentFile=/opt/shipit/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/shipit/.venv/bin/python -m app.alerts "Drydock: systemd unit %i failed on the production VPS"
TimeoutStartSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
