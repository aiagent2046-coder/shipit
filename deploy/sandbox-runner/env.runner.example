# /opt/shipit-runner/.env.runner  (mode 0640, owner root, group shipit-runner)
#
# The sandbox-runner's OWN environment. It must NOT contain any prod secret
# the backend holds — no DATABASE_URL, no billing keys, no PEPPER, no Telegram
# or admin tokens. The whole point of Variant A is that a runner compromise
# does not leak these. Keep this file minimal.

# Shared bearer token, second line of defence behind the socket file perms.
# Generate once: `openssl rand -hex 32`. MUST match SANDBOX_RUNNER_TOKEN in the
# backend's /opt/shipit/.env.
SANDBOX_RUNNER_TOKEN=replace-with-openssl-rand-hex-32

# Max concurrent docker build/run operations (O3). Default 2 == prod VPS vCPUs.
SANDBOX_RUNNER_CONCURRENCY=2

# Egress-allowlist proxies the container hardening expects on the prod host.
# Leave as-is for prod (host Squid); the e2e workflow clears them because a
# GitHub runner has no such proxy.
# DEPLOYPACK_BUILD_PROXY_URL=http://host.docker.internal:3128
# FIXPACK_INSTALL_PROXY_URL=http://host.docker.internal:3128

# Pre-created no-egress network for preview/boot containers (host admin creates
# it; see README). Runner only attaches to it, never creates it.
# DEPLOYPACK_PREVIEW_NETWORK=shipit-preview

# Optional isolated bridge network for Fix Pack dependency-install containers
# (whose host DOCKER-USER rules only allow tcp/3128 to the host Squid proxy and
# drop direct egress). Leave unset to use the default bridge + --dns=127.0.0.1.
# FIXPACK_INSTALL_NETWORK=shipit-install

