# LLM provider chain (.env is the single source of truth).
# RULE: no inline comments after values on the same line -- systemd's
# EnvironmentFile does NOT strip them, the comment becomes part of the
# value (this exact bug produced a garbage ANTHROPIC_API_KEY and a 401
# in production before it was found).

# Primary: AITunnel (OpenAI-compatible). ALL three lines required --
# the provider is silently skipped if any is missing.
AITUNNEL_API_KEY=
# AITunnel base URL (e.g. https://aitunnel.ai/v1). Must match the
# provider's OpenAI-compatible /chat/completions endpoint.
AITUNNEL_BASE_URL=
AITU...n
# Model name must match the PROVIDER's naming, not Anthropic's
# canonical one. Example: AITunnel calls it claude-sonnet-4.6 (dot),
# while the direct Anthropic API calls it claude-sonnet-4-6 (dash) --
# the wrong one is a 400 from /chat/completions. Defaults to the
# Anthropic canonical name when unset.
LLM_MODEL=

# Direct Anthropic fallback. Leave the line out entirely if unused
# (geo-blocked from RU-hosted servers; a non-empty garbage value puts
# a dead provider in the chain).
ANTHROPIC_API_KEY=*** Abuse protection for /v1/audits (per client IP, fixed 24h window)
AUDIT_RATE_LIMIT_PER_DAY=5

# Optional. When set, the rate limiter is backed by Redis so the daily
# budget survives process restarts/deploys and is shared across workers.
# Unset -> in-memory limiter (single process, resets on restart) -- the
# app works either way. Example: redis://default:***@<host>:<port>
REDIS_URL=

# PR delivery for Deploy Pack: GitHub App installation token when both
# APP_* values are set (works for any repo the App is installed on),
# falling back to the single-operator token below otherwise.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# Alternative to GITHUB_APP_PRIVATE_KEY (the PEM file). Base64-encoded
# private key for the GitHub App, used when the PEM can't be stored as
# a multi-line string (systemd EnvironmentFile, some secret managers).
# app/deploypack/github_app.py prefers this over the PEM variant when
# both are set. Encode: base64 -w0 < app.private-key.pem
GITHUB_APP_PRIVATE_KEY_B64=

GITHUB_PR_TOKEN=*** Public slug of the GitHub App (the <slug> in github.com/apps/<slug>), used
# to build the "Install GitHub App" link shown on GET
# /v1/github/installation-status when the App isn't installed on a repo.
# Defaults to the real App slug, so this only needs setting for a differently
# named App.
GITHUB_APP_SLUG=aiagent2046-coder-shipit

# Secret for verifying incoming GitHub App webhooks (POST /v1/webhooks/github),
# used to record whether a delivered Fix Pack PR was merged (fix_outcomes.
# pr_merged). Must equal the "Webhook secret" configured in the GitHub App's
# settings, and the App must be subscribed to the "Pull request" event there --
# both are manual, one-time steps in the GitHub UI (see README). The endpoint
# 503s until this is set; the pr_merged signal simply stays null until then.
# Generate: openssl rand -hex 32
GITHUB_APP_WEBHOOK_SECRET=*** Ephemeral preview hosting's scheduled reaper -- POST
# /internal/preview/reap refuses to run at all if this is unset.
# Generate: openssl rand -hex 32
PREVIEW_REAP_TOKEN=*** Fix Pack generator's scheduled processor -- POST
# /internal/fixpack/process-paid turns paid Fix Pack jobs into fix PRs and
# refuses to run at all if this is unset. Generate: openssl rand -hex 32
FIXPACK_PROCESS_TOKEN=*** Continuous-monitoring scheduled processor -- POST
# /internal/monitoring/process-pending drains queued monitoring runs
# (re-audit + diff + notify) off the GitHub push webhook's HTTP path and
# refuses to run at all if this is unset. Generate: openssl rand -hex 32
MONITORING_PROCESS_TOKEN=*** LLM cost-management enforcement (Stage 4 step 2). All optional; the
# defaults shown are what the code uses when unset.
#
# Per-job spend ceiling for a single scan's sequential LLM-call loop. When the
# running cost estimate crosses this, the scan stops early and returns a
# partial result flagged cost_cap_exceeded (never an error). USD.
JOB_COST_CAP_USD=3.00
# Daily USD backstop over ALL anonymous/free traffic (summed since UTC
# midnight). Crossing it soft-degrades new anonymous audits to static-only --
# NOT a per-IP or per-account limit, and NOT applied to pro accounts (those
# are bounded by PRO_DAILY_AUDIT_LIMIT instead). USD.
DEFAULT_DAILY_SPEND_CAP_USD=2.00
# Max concurrent LLM-backed scans in flight on this instance (I/O-bound).
AUDIT_CONCURRENCY=4
# Emergency-stop toggle -- POST /internal/service-flags/llm_paid_ops flips the
# llm_paid_ops kill switch (pauses paid LLM ops: audits 503, monitoring drain
# no-ops). Refuses to run at all if this is unset. Generate: openssl rand -hex 32
SERVICE_FLAGS_TOKEN=*** Docker runtime for the containers that install + run untrusted CLIENT code
# during a Fix Pack semantic check. Default "runc" is Docker's standard
# runtime. Set to "runsc" (gVisor) on a host where it is installed and
# registered in /etc/docker/daemon.json to add a second, user-space kernel
# boundary against unknown container-escape bugs. Opt-in and reversible:
# leaving this "runc" (or unset) is byte-for-byte identical to no runtime
# flag. Do NOT set "runsc" until runsc is actually installed on the host --
# an unregistered runtime makes docker run fail (degrades to "could not
# verify", never a false regression).
FIXPACK_DOCKER_RUNTIME=runc

# --- Docker sandbox hardening (Deploy Pack / Fix Pack) ---
#
# These control how the untrusted-code containers are run. Every option is
# optional and defaults to the locked-down value shown. Set to "0" to
# opt-OUT of a hardening measure (e.g. for debugging).
#
# Read-only root filesystem for the build/verify container. "1" (default) =
# container FS is read-only except for explicit tmpfs mounts. Set to "0" to
# allow writes.
FIXPACK_READONLY_ROOTFS=1
DEPLOYPACK_READONLY_ROOTFS=1

# Run the container payload as a non-root user. When set, the container
# runtime creates a user with this name/uid and runs the payload under it
# (no sudo, no cap-adds). Unset = root inside the container (the outer
# Docker namespace is still isolated).
FIXPACK_RUN_AS_USER=
DEPLOYPACK_RUN_AS_USER=

# HTTP proxy URL for pip/npm install steps inside the build container.
# Defaults to http://host.docker.internal:3128 (a local caching proxy).
# Only relevant if a proxy is running on the Docker host.
FIXPACK_INSTALL_PROXY_URL=http://host.docker.internal:3128

# Deploy Pack build proxy (defaults to FIXPACK_INSTALL_PROXY_URL above when
# unset -- they usually share one proxy).
DEPLOYPACK_BUILD_PROXY_URL=

# Docker network name for deploy-preview containers. Default: shipit-preview.
DEPLOYPACK_PREVIEW_NETWORK=shipit-preview

# Allow the Deploy Pack runtime container to reach the network (e.g. to
# call an external API during the deployed app's smoke test). "0" (default)
# = network disabled (--network none). Set to "1" to allow.
DEPLOYPACK_ALLOW_RUNTIME_NETWORK=0

# CORS for the browser frontend (separate Vercel deployment calling this
# API). Deny-by-default: unset means NO cross-origin browser access, NOT
# "*" -- a wildcard plus the Authorization: Bearer *** this API now takes
# would let any site make credentialed calls. Comma-separated exact
# origins, no trailing slash, scheme included.
CORS_ALLOWED_ORIGINS=
# Set to true to also allow Vercel PREVIEW deploys (per-deploy subdomains
# like https://shipit-web-<hash>-<team>.vercel.app, matched by regex).
# Explicit opt-in; anything other than "true" (incl. unset) is off.
CORS_ALLOW_VERCEL_PREVIEWS=

# Deployment metadata surfaced on the /health endpoint and in the
# production-operations readiness probe (/internal/ops/readiness).
# Both optional -- sensible defaults when unset.
ENVIRONMENT=development
SHIPIT_RELEASE=

# Fix Pack pricing (a per-audit product, separate from the Pro tier).
# Both optional -- sensible defaults apply when unset (600 Stars, 12 USDT),
# same env-overridable-with-default pattern as the Pro prices
# (TELEGRAM_PRO_STARS / USDT_PRICE).
FIXPACK_STARS_PRICE=600
FIXPACK_USDT_PRICE=12

# Recurring subscription price, in Stars (default 1). This is the throwaway
# 'test-monitoring' tier used only to prove recurring billing end to end
# (a real Stars charge that renews and can be canceled) -- NOT the final
# Phase C monitoring price. The subscription period itself is fixed at 30
# days by the Bot API and is not configurable. Stars-only: USDT can't
# auto-charge, so it stays one-time.
SUBSCRIPTION_STARS=1

# --- Telegram Stars billing ---

# Pro tier price in Telegram Stars. Default 250.
TELEGRAM_PRO_STARS=250

# Secret for verifying incoming Telegram Bot API webhooks (set in
# @BotFather's /setwebhook). HMAC-SHA256 of the bot token + update body,
# verified on every POST /v1/webhooks/telegram. The endpoint 503s until
# this is set (inferred from TELEGRAM_BOT_TOKEN presence).
# Generate: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=*** Operator alerts (Phase 3 observability). Best-effort push notifications
# for high-signal failures (a failed Fix Pack job, an unhandled 5xx, a
# systemd service crash) over the SAME Telegram bot the Stars payment flow
# already uses -- no new integration. Alerting is entirely opt-in: with
# either value unset it's a silent no-op, so nothing here can break a
# request or a job. TELEGRAM_BOT_TOKEN is the existing payment bot's token;
# TELEGRAM_ADMIN_CHAT_ID is the operator's own chat id (message the bot,
# then read chat.id from getUpdates).
TELEGRAM_BOT_TOKEN=
TELE...n
# Optional log level for the explicit logging config (CRITICAL/ERROR/
# WARNING/INFO/DEBUG). Defaults to INFO; an unrecognized value falls back
# to INFO rather than erroring.
LOG_LEVEL=

# Persistence: Supabase Session Pooler string (port 5432,
# ...pooler.supabase.com), NOT the direct db.<ref>.supabase.co one
# (IPv6-only) and NOT the https:// project API URL. app/db.py persists
# audits + fixpack_jobs when set, degrades to unpersisted otherwise.
DATABASE_URL=

# --- USDT / TRC-20 billing (Tron blockchain) ---
#
# Additive and entirely opt-in: with the credentials unset, the USDT
# endpoints 503 and no on-chain polling happens. The USDT flow is a
# SEPARATE alternative to both Telegram Stars and PayPal, not a combined
# checkout -- a user picks one payment rail.
#
# TronGrid API key for querying TRC-20 transfers (free tier at
# trongrid.io). Unset -> USDT polling is disabled.
TRONGRID_API_KEY=*** The fixed receiving address for USDT payments. A TRC-20 address on
# Tron mainnet (starts with 'T'). This is the public deposit address
# shown to users; incoming transfers to it are scanned for payment
# confirmation.
USDT_TRC20_ADDRESS=

# The USDT contract address on Tron (TRC-20 token). Default is the
# official Tether USDT contract: TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t.
# Override only for testnet tokens or alternative stablecoins.
USDT_TRC20_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t

# Pro tier price in USDT. Default 5.
USDT_PRICE=5

# Internal bearer token for the operational USDT poller endpoint
# (POST /internal/billing/poll-usdt, called by systemd timer).
# Refuses to run if unset. Generate: openssl rand -hex 32
USDT_POLL_TOKEN=*** --- PayPal Checkout (an ALTERNATIVE to Telegram Stars / USDT) ---
#
# Additive and entirely opt-in: with the credentials unset, the PayPal
# endpoints 503 and the Stars/USDT flows are byte-for-byte unchanged. Wire
# these in AFTER the plan is approved, from a PayPal Business account's app
# in the PayPal Developer Dashboard. DO NOT commit real values -- leave them
# blank here and set them in the deployment's environment (systemd
# EnvironmentFile / Vercel env), same as every other secret above.
#
# The REST app's client id and secret (OAuth2 client-credentials). Both must
# be set for any PayPal endpoint to work (is_configured()); either unset ->
# 503 paypal_not_configured. The client id's PUBLIC half also goes in the
# FRONTEND as NEXT_PUBLIC_PAYPAL_CLIENT_ID; the SECRET stays backend-only.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=*** Which PayPal environment to hit. Anything other than "live" (incl. unset)
# means the sandbox -- fail-safe toward the test environment. Set to "live"
# only with live credentials on the production deployment.
PAYPAL_ENV=sandbox

# The webhook id from the app's webhook config. Sent to PayPal's
# verify-webhook-signature API to authenticate each incoming webhook (PayPal
# is RSA-signed and verified by an outbound call, NOT a local HMAC like
# Telegram/GitHub). Unset -> POST /v1/webhooks/paypal 503s, because an
# unverifiable webhook must never be trusted.
PAYPAL_WEBHOOK_ID=

# The PayPal billing plan id ('P-XXXX') for the recurring monitoring
# subscription, created once out-of-band in the PayPal dashboard (or via the
# Catalog/Plans API). Unset -> POST /v1/paypal/subscriptions 503s. The
# monitoring PRICE lives in this plan, not in an env var.
PAYPAL_MONITOR_PLAN_ID=

# One-time product prices in fiat USD, env-overridable with defaults (5.00
# Pro, 10.00 Fix Pack) -- same pattern as FIXPACK_USDT_PRICE. An unparseable
# value falls back to the default rather than sending garbage to PayPal.
PAYPAL_PRO_PRICE_USD=5.00
PAYPAL_FIXPACK_PRICE_USD=10.00

# --- Sandbox Runner (Fix Pack / Deploy Pack container executor) ---
#
# The sandbox runner is a separate systemd service that executes untrusted
# code in Docker containers on behalf of the main API process. Connection
# is via Unix domain socket (preferred, same host) or HTTPS URL. The runner
# is additive: with the credentials unset, sandbox endpoints 503 and the
# legacy in-process Docker path is used instead.
#
# Path to the Unix domain socket for the local sandbox runner daemon.
# Default: /run/shipit-runner/sandbox.sock. Used when SANDBOX_RUNNER_URL is
# empty (local mode via UDS).
SANDBOX_RUNNER_UDS=/run/shipit-runner/sandbox.sock

# HTTPS URL of a remote sandbox runner (e.g. https://runner.shipit.example).
# When set, this is used INSTEAD of the UDS path above. Both empty = sandbox
# runner is disabled (= legacy in-process path).
SANDBOX_RUNNER_URL=

# Bearer token the API presents to the sandbox runner for authentication
# (Authorization: Bearer *** Must match what the runner's
# SANDBOX_RUNNER_TOKEN is set to. Unset -> sandbox endpoints 503.
# Generate: openssl rand -hex 32
SANDBOX_RUNNER_TOKEN=*** Max concurrent sandbox jobs the runner will accept. Default 2.
SANDBOX_RUNNER_CONCURRENCY=2

# Hard timeout in seconds for a single sandbox job (build + verify).
# Default 600 (10 minutes). The runner kills the container after this.
SANDBOX_RUNNER_TIMEOUT_S=600
