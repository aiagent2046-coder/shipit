# Backend configuration template. Required fields and integration conditions:
# docs/configuration.md. The deployed file is /opt/shipit/.env; releases do
# not overwrite it. Keep actual credentials out of this example.
# RULE: no inline comments after values on the same line -- systemd's
# EnvironmentFile does NOT strip them, the comment becomes part of the
# value (this exact bug produced a garbage ANTHROPIC_API_KEY and a 401
# in production before it was found).

# Required in the production env file itself: the file validator ignores
# shell exports and systemd Environment= settings. Set development only for
# local development (including interactive API docs).
ENVIRONMENT=production

# Required for queued audits and in production. Use a PostgreSQL connection
# URI, not a Supabase HTTPS project URL. For the deployed Supabase setup use
# its Session Pooler connection string. Without a DB, audit intake is 503.
DATABASE_URL=

# Required whenever DATABASE_URL is configured, including local development.
# Generate once: openssl rand -hex 32. Use the same value in every backend
# process; changing it invalidates verification of existing account/MCP keys.
API_KEY_PEPPER=

# LLM provider chain. Optional: without a provider scans are static-only.
# Primary: AITunnel (OpenAI-compatible). BOTH lines required --
# the provider is silently skipped if either is missing.
AITUNNEL_API_KEY=
AITUNNEL_BASE_URL=

# Model name must match the PROVIDER's naming, not Anthropic's
# canonical one. Example: AITunnel calls it claude-sonnet-4.6 (dot),
# while the direct Anthropic API calls it claude-sonnet-4-6 (dash) --
# the wrong one is a 400 from /chat/completions. Defaults to the
# Anthropic canonical name when unset.
#
# This is the name for the WHOLE chain, which is right only while the
# chain has one provider. With two, one spelling configures the primary
# and mis-configures the fallback -- which then fails for a reason that
# has nothing to do with the outage it exists to survive. Set the two
# lines below instead, each in its own provider's spelling; either one
# unset falls back to LLM_MODEL.
LLM_MODEL=
AITUNNEL_LLM_MODEL=
ANTHROPIC_LLM_MODEL=

# Direct Anthropic fallback. Leave the line out entirely if unused
# (geo-blocked from RU-hosted servers; a non-empty garbage value puts
# a dead provider in the chain).
ANTHROPIC_API_KEY=

# Abuse protection for /v1/audits (per client IP, fixed 24h window)
AUDIT_RATE_LIMIT_PER_DAY=5

# Optional. When set, the rate limiter is backed by Redis so the daily
# budget survives process restarts/deploys and is shared across workers.
# Unset -> in-memory limiter (single process, resets on restart) -- the
# app works either way. Example: redis://default:<password>@<host>:<port>
# REDIS_URL=

# PR delivery for Deploy Pack: GitHub App installation token when both
# APP_* values are set (works for any repo the App is installed on),
# falling back to the single-operator token below otherwise.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_PR_TOKEN=

# Public slug of the GitHub App (the <slug> in github.com/apps/<slug>), used
# to build the "Install GitHub App" link shown on GET
# /v1/github/installation-status when the App isn't installed on a repo.
# Defaults to the real App slug, so this only needs setting for a differently
# named App.
GITHUB_APP_SLUG=aiagent2046-coder-shipit

# Secret for verifying incoming GitHub App webhooks (POST /v1/webhooks/github),
# used to record whether a delivered Fix Pack PR was merged (fix_outcomes.
# pr_merged). Must equal the "Webhook secret" configured in the GitHub App's
# settings, and the App must be subscribed to the "Pull request" event there --
# both are manual, one-time steps in the GitHub UI (see README). The endpoint
# 503s until this is set; the pr_merged signal simply stays null until then.
# Generate: openssl rand -hex 32
GITHUB_APP_WEBHOOK_SECRET=

# Required in production. Ephemeral preview hosting's scheduled reaper -- POST
# /internal/preview/reap refuses to run at all if this is unset.
# Generate: openssl rand -hex 32
PREVIEW_REAP_TOKEN=

# Required in production. Fix Pack generator's scheduled processor -- POST
# /internal/fixpack/process-paid turns paid Fix Pack jobs into fix PRs and
# refuses to run at all if this is unset. Generate: openssl rand -hex 32
FIXPACK_PROCESS_TOKEN=

# Required in production. Continuous-monitoring scheduled processor -- POST
# /internal/monitoring/process-pending drains queued monitoring runs
# (re-audit + diff + notify) off the GitHub push webhook's HTTP path and
# refuses to run at all if this is unset. Generate: openssl rand -hex 32
MONITORING_PROCESS_TOKEN=

# Memory ceiling for each container that runs untrusted client code (Fix Pack
# verification). Default 512m. Too small for a monorepo: pnpm resolving a
# workspace's dependency graph is the heaviest thing the sandbox runs, and on
# a real one 512m produced exit 137 (SIGKILL from the OOM killer) after 24
# seconds. Raising it costs host RAM per concurrent Fix Pack, so size it
# against this machine rather than copying a number.
#FIXPACK_MEMORY_LIMIT=2g

# LLM cost-management enforcement (Stage 4 step 2). All optional; the
# defaults shown are what the code uses when unset.
#
# Per-job spend ceiling for a single scan's sequential LLM-call loop. When the
# running cost estimate crosses this, the scan stops early and returns a
# partial result flagged cost_cap_exceeded (never an error). USD.
#
# A backstop against a runaway loop, NOT a budget: it must stay above what a
# full scan is meant to cost, or every large-repo Fix Pack stops mid-scan and
# returns a partial result silently. A paid audit is passes=2 (union-of-N,
# PAID_AUDIT_PASSES) and a real repository measured ~$3.93/pass, so the cap
# must clear ~$7.86 with backstop room or every large paid audit loses part
# of its second pass; tests/test_llm_enforcement.py fails if this is too low.
JOB_COST_CAP_USD=13.00
# Daily USD backstop over ALL anonymous/free traffic (summed since UTC
# midnight). Crossing it soft-degrades new anonymous audits to static-only --
# NOT a per-IP or per-account limit, and NOT applied to pro accounts (those
# are bounded by PRO_DAILY_AUDIT_LIMIT instead). USD.
#
# Load-bearing again as of the preview scan: the free tier reaches the
# provider now, so this is the only thing between an unauthenticated visitor
# and an arbitrary bill. At the measured ~$0.077 per preview, $20.00 is about
# 260 free scans a day. It is a funnel decision, not a safety margin -- too low
# and the product goes quiet for the rest of the day to everyone who arrives
# after it trips.
DEFAULT_DAILY_SPEND_CAP_USD=20.00
# Required in production. Emergency-stop toggle -- POST
# /internal/service-flags/llm_paid_ops flips the
# llm_paid_ops kill switch (pauses paid LLM ops: audits 503, monitoring drain
# no-ops). Refuses to run at all if this is unset. Generate: openssl rand -hex 32
SERVICE_FLAGS_TOKEN=

# Audit worker (`python -m app.worker`, shipit-audit-worker.service). POST
# /v1/audits only enqueues; this process runs the scans, so its slot count IS
# the ceiling on concurrent LLM-backed scans (it replaced the API-side
# AUDIT_CONCURRENCY semaphore). All optional; defaults shown.
AUDIT_WORKER_CONCURRENCY=4
AUDIT_WORKER_POLL_INTERVAL_SECONDS=2
AUDIT_WORKER_LEASE_TTL_SECONDS=300
# How often the worker writes its one-line queue-depth heartbeat record. This
# is not the lease heartbeat (that is derived from the lease TTL above and is
# not tunable): it is the metric-as-a-log-event that makes a coarse time series
# recoverable with
#   journalctl -u shipit-audit-worker | jq -c 'select(.event=="heartbeat")'
# on a box with no room for a metrics server. Lower it to make an incident
# timeline finer-grained; the cost is one journal line per interval.
AUDIT_WORKER_STATS_INTERVAL_SECONDS=300
# Where uploaded archives are staged for the worker to pick up. Must be
# writable by both units; see deploy/scripts/provision-audit-spool.sh.
AUDIT_SPOOL_DIR=/srv/shipit/spool
# Reader token for GET /internal/stats (all queues, LLM spend, error rate) and
# for the older GET /internal/audit-jobs/stats, which is the audit-queue subset
# of it. One token: both are reads for the same monitoring audience.
# Unset disables both endpoints. Generate: openssl rand -hex 32
AUDIT_JOBS_STATS_TOKEN=

# Required for sandbox-backed verification and preview operations. Generate
# once: openssl rand -hex 32. This must match the runner's own .env.runner;
# never copy DATABASE_URL, API_KEY_PEPPER or billing credentials to the runner.
# A missing runner token gives 503; a missing/mismatched client token gives 401
# when the runner is configured. The production env validator does not check
# runner connectivity or this shared token. See deploy/sandbox-runner/README.md.
SANDBOX_RUNNER_TOKEN=
# Optional transport overrides; the Unix socket is the code default.
# SANDBOX_RUNNER_UDS=/run/shipit-runner/sandbox.sock
# SANDBOX_RUNNER_URL=

# Docker runtime for the containers that install + run untrusted CLIENT code
# during a Fix Pack semantic check. Default "runc" is Docker's standard
# runtime. Set to "runsc" (gVisor) on a host where it is installed and
# registered in /etc/docker/daemon.json to add a second, user-space kernel
# boundary against unknown container-escape bugs. Opt-in and reversible:
# leaving this "runc" (or unset) is byte-for-byte identical to no runtime
# flag. Do NOT set "runsc" until runsc is actually installed on the host --
# an unregistered runtime makes docker run fail (degrades to "could not
# verify", never a false regression).
FIXPACK_DOCKER_RUNTIME=runc

# CORS for the browser frontend (separate Vercel deployment calling this
# API). Required in production. Deny-by-default: unset means NO cross-origin
# browser access, NOT
# "*" -- a wildcard plus the Authorization: Bearer key this API now takes
# would let any site make credentialed calls. Comma-separated exact
# origins, no trailing slash, scheme included.
CORS_ALLOWED_ORIGINS=
# Set to true to also allow Vercel PREVIEW deploys (per-deploy subdomains
# like https://shipit-web-<hash>-<team>.vercel.app, matched by regex).
# Explicit opt-in; anything other than "true" (incl. unset) is off.
CORS_ALLOW_VERCEL_PREVIEWS=

# Telegram operator alerts and manual bank-transfer confirmations.
# Both are needed for alerts. Both plus TELEGRAM_WEBHOOK_SECRET are required
# in production when BANK_TRANSFER_CARD or BANK_TRANSFER_ACCOUNT is set.
# TELEGRAM_ADMIN_CHAT_ID identifies the operator allowed to confirm payments.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Required for incoming bot webhooks: match the secret_token supplied to
# Telegram setWebhook. Missing bot token or secret makes the webhook return
# 503. Outbound alerts alone do not require a webhook secret.
# Generate once: openssl rand -hex 32.
TELEGRAM_WEBHOOK_SECRET=
# Optional public bot username for customer links; no leading @ is needed.
# Configure on the backend; the frontend reads it from the API.
TELEGRAM_BOT_USERNAME=

# Optional log level for the explicit logging config (CRITICAL/ERROR/
# WARNING/INFO/DEBUG). Defaults to INFO; an unrecognized value falls back
# to INFO rather than erroring.
LOG_LEVEL=

# Log output shape. `json` emits one JSON object per line for
# `journalctl -o cat | jq`, carrying audit_id/job_id/request_id as real fields
# instead of buried in a sentence; `text` is the plain
# "<time> <LEVEL> <logger> <message>" line every process emitted before Stage 5.
# Secret redaction applies to both.
#
# `json` is set here because that is what production already runs, so a host
# rebuilt from this file keeps the queryable format instead of silently
# reverting. Note the CODE-level fallback is still `text`: an unset or
# unrecognized value means text (app/logging_config.py), so this line is what
# makes json happen and removing it is a downgrade, not a no-op.
LOG_FORMAT=json

# Which process a log line came from (`shipit`, `shipit-audit-worker`, ...),
# so one journalctl query spanning several units can still tell them apart.
# Set per systemd unit; only appears in the output when LOG_FORMAT=json.
SHIPIT_SERVICE=

# --- YooKassa card checkout -----------------------------------------------
# Optional integration: set both credentials or neither. Production validation
# rejects a half-configured pair; without the pair card checkout returns 503.
# A test_ key uses the test shop; it does not collect real payments.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Optional receipt settings, using the merchant's configured codes. No defaults
# are guessed: without VAT_CODE the application sends no receipt. TAX_SYSTEM_CODE
# is only used when a receipt is enabled. See docs/configuration.md.
YOOKASSA_VAT_CODE=
YOOKASSA_TAX_SYSTEM_CODE=

# --- Bank transfer (manually confirmed by the operator) ---
#
# Optional: the operator confirms each transfer through Telegram. All six bank
# details below are required for the rail to work; otherwise it answers 503.
# The production validator additionally requires the Telegram token, operator
# chat id and webhook secret when CARD or ACCOUNT is populated.
#
# The six details below are ONE PRIVATE INDIVIDUAL'S real banking data, so:
# leave them blank here and set them only in the deployment's environment.
# They are PUBLISHED by GET /v1/billing/details (the site footer renders them),
# but never mirrored into a NEXT_PUBLIC_* variable -- that endpoint is the
# single source, so rotating the card is an env change plus a restart with no
# frontend rebuild. All six are required together -- a payer with a SWIFT code
# but no account number cannot send anything, so a partially configured
# deployment reads as unconfigured (503).
#
# BANK_TRANSFER_CARD is the only one the checkout page shows: the payer copies
# the card number and pays. The other five are the full requisites behind that
# card, shown in the footer for a payer whose bank needs them.
#
# Values with spaces MUST be double-quoted (BANK_TRANSFER_BANK_NAME,
# BANK_TRANSFER_BENEFICIARY, BANK_TRANSFER_ADDRESS): systemd's EnvironmentFile
# copes without quotes, but `source .env` in a shell does not.
BANK_TRANSFER_CARD=
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_SWIFT=
BANK_TRANSFER_BENEFICIARY=
BANK_TRANSFER_ACCOUNT=
BANK_TRANSFER_ADDRESS=

# Optional RUB prices. The Fix Pack price is shared by bank transfer and
# YooKassa; the Pro price applies to the existing bank-transfer endpoint.
# Unset values use the code defaults shown below. The invoice uses the exact
# price; no identifying kopeck suffix is added. Pro is not advertised in the
# storefront; its price still applies to the existing Pro endpoint.
# BANK_TRANSFER_PRO_PRICE_RUB=490.00
# BANK_TRANSFER_FIXPACK_PRICE_RUB=990.00
#
# PayPal, USDT and Stars sale settings, and BANK_TRANSFER_*_PRICE_USD, are
# retired. They do not configure the current payment rails. Remove stale
# assignments when reviewing a host env file; a deployment never rewrites it.

# --- outbound email -------------------------------------------------------
# The channel a customer who is not on Telegram is told anything on: their
# transfer was confirmed, their refund was sent. Migration 0026 said of
# payments.payer_email that "nothing is ever sent to this address"; that
# stopped being true, and this is what makes it send.
#
# UNSET IS A SILENT NO-OP, and that is the trap to understand before leaving
# it unset. Nothing fails. A refund is recorded, the customer is never told,
# and app/notify/router.py pages the operator that nobody could be reached --
# on every such refund. The software is behaving correctly; the customer is
# still in the dark.
#
# SMTP_HOST and SMTP_FROM are the pair that turns the channel on, and the
# validator refuses a deployment that sets one without the other: half of a
# delivery channel is indistinguishable from none, except that it looks
# configured.
SMTP_HOST=
SMTP_FROM=

# 587 (STARTTLS) is the default and the usual submission port. 465 is the
# other common one and means TLS from the first byte -- app/notify/email.py
# switches on the number, so the port is not cosmetic. On anything but 465 a
# server that cannot upgrade to TLS gets no credentials and no message: the
# alternative is sending a customer's details, and this password, in the
# clear because a certificate was missing.
SMTP_PORT=587

# Optional as a pair: a relay on localhost, or one that authenticates by IP,
# needs neither. Set both or neither -- the validator checks that too, because
# a username with no password authenticates as nobody and the send fails on
# every message with an error the operator never sees.
SMTP_USERNAME=
SMTP_PASSWORD=

# --- free tier (preview scan) ---------------------------------------------
# Which model and which rubrics the preview spends on. One rubric on the
# cheapest model is what makes the giveaway affordable; widening either costs
# money per anonymous request, bounded only by the cap above.
#
# SAME NAMING TRAP AS LLM_MODEL ABOVE, and it bites harder here. The value
# must be spelled the way YOUR provider spells it: AITunnel wants
# claude-haiku-4.5 (dot), the direct Anthropic API wants claude-haiku-4-5
# (dash), and the wrong one is a 400 on every preview.
#
# The code default is the dashed, Anthropic-canonical name -- so on an
# AITunnel-only deployment, leaving this UNSET means every free scan 400s and
# silently degrades to static-only. The operator sees `llm: failed:` and a
# provider alert; the visitor just sees a thinner report and no error. This
# line was measured wrong exactly that way before it was ever deployed.
#
# Set it to match whichever provider is first in your chain.
#
# `glm-5.3-flash` is also priced and classified, and AITunnel serves it under
# exactly that spelling. Measured 2026-08-28 against the Haiku it would
# replace: roughly 13x cheaper on input and 20x on output, `finish_reason:
# stop` at the rubric path's max_tokens=8192, and clean JSON. It is a
# REASONING model -- two thirds of its completion tokens on that probe were
# reasoning, billed as output -- so its output rate is the one that decides
# the bill, and it is still an order of magnitude below.
#
# CHANGING THIS IS AN ENGINE CHANGE. The preview's cached results are keyed on
# AUDIT_ENGINE_VERSION (app/scan/pipeline.py), which no test can move for you
# here: the model lives in this file, not in the code. Switch the model and
# deploy the bump together, or every repository already in the cache keeps
# being served its pre-switch preview and the change looks like it did not
# work.
FREE_TIER_LLM_MODEL=claude-haiku-4.5
#
# ...and the same per-provider split, for the same reason. It matters more
# here than above: the preview is what anonymous visitors get, so a fallback
# that 400s makes every free scan static-only on the day the primary is down,
# and the visitor sees a thinner report with no error to tell them why.
FREE_TIER_LLM_MODEL_AITUNNEL=
FREE_TIER_LLM_MODEL_ANTHROPIC=
FREE_TIER_LLM_RUBRICS=security

# --- Proof-of-fix checks ----------------------------------------------------
# How a non-verified proof affects Fix Pack delivery (app/proof/gate.py):
#   off   record and render only, never influences delivery
#   soft  deliver, but the PR carries a warning
#   hard  withhold the PR entirely (default, including on an unknown value)
# Infrastructure failures and skipped templates never block, in any mode --
# `hard` withholds only when the exploit reproduced BEFORE the patch and the
# same check still succeeded AFTER it. "We could not prove anything" is a
# different state and always delivers.
#
# Left EMPTY on purpose so the code default governs. Pinning `soft` here is
# how a deployment seeded from this file would keep shipping unproven repairs
# after the default changed -- the same shape as the LLM_MODEL line that
# turned every paid audit static-only on 2026-08-28.
PROOF_GATE_MODE=
#
# The RUNTIME CORS probe: build and boot the customer's app in the sandbox,
# send a real cross-origin request, judge the response headers
# (PROOF_RUNTIME_CORS_PLAN.md). Off by default and deliberately so — it costs
# two container builds per job, and as of this line no customer workspace has
# ever been booted by it. Turn it on only on a host where the first real boot
# can be watched, and run scripts/e2e_proof_cors_probe.py there first.
# Accepts 1/true/yes/on.
PROOF_RUNTIME_CORS=0

# --- MCP for editors --------------------------------------------------------
# The Model Context Protocol endpoint (POST /mcp), which lets an agent inside
# Cursor or another editor run an audit and read its own results. OFF unless
# this is set to 1/true/yes: unset means the endpoint answers 404, the same
# posture as every retired payment rail here — a rail not carrying traffic
# does not exist rather than existing and failing.
#
# What it costs when on: MCP keys are anonymous traffic by construction, so
# they land under DEFAULT_DAILY_SPEND_CAP_USD above along with every other
# free scan. There is no separate MCP budget, and there deliberately is not:
# one cap is one number to watch.
#
# Keys live in mcp_api_keys (migration 0036) and are minted with
# scripts/mint_mcp_key.py on the box. Turning the flag off does not revoke
# them; it makes the endpoint they authenticate against disappear.
MCP_ENABLED=0
