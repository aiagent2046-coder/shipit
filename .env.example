# LLM provider (multi-provider layer; .env is the single source of truth)
AITUNNEL_API_KEY=
ANTHROPIC_API_KEY=          # direct fallback
# Abuse protection for /v1/audits (per client IP, fixed 24h window)
AUDIT_RATE_LIMIT_PER_DAY=5
# PR delivery for Deploy Pack: GitHub App installation token when both
# of these are set (works for any repo the App is installed on),
# falling back to the single-operator token below otherwise.
GITHUB_APP_ID=                    # Client ID (Iv23...) recommended, numeric App ID also works
GITHUB_APP_PRIVATE_KEY=            # full PEM contents
GITHUB_PR_TOKEN=
# Ephemeral preview hosting's scheduled reaper (see
# .github/workflows/preview-reaper.yml) -- POST /internal/preview/reap
# refuses to run at all if this is unset.
PREVIEW_REAP_TOKEN=
# Storage (phase 1+). DATABASE_URL is real now -- app/db.py persists
# audits + fixpack_jobs when set, degrades to unpersisted otherwise.
DATABASE_URL=
REDIS_URL=
S3_ENDPOINT=
S3_BUCKET=
