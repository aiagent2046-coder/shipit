__pycache__/
*.py[cod]
.venv/
.env
.pytest_cache/
dist/

# build artifacts
*.egg-info/
batch_reports/
.release-env

# Local environment backups containing secrets
.env.bak*

# scripts/env_keys.py writes the NAMES of an env file's variables here
# (never values) so a hand edit that drops one is visible afterwards.
# Ignored not because it is secret -- it is not -- but because it lands
# in /opt/shipit, which is a git checkout, and deploy-production.sh
# refuses to deploy with any untracked file present.
.env.keys

# Private key material. GitHub App keys download as
# <app-slug>.<date>.private-key.pem and land in whatever directory the browser
# was pointed at -- on 2026-08-03 the live App key was sitting untracked in the
# root of a working copy, one `git add -A` away from being committed.
#
# The CI secret scanner would have caught it (private-key-header), but that is
# the last line, not the first: by then the key is in someone's local history
# and in a pushed branch.
*.pem
*.p12
*.pfx
id_rsa
id_ed25519

# The rotation stand's synthetic credentials and the directories that ship
# them. Generated by smoke/service_role_bundle/mint_rotation_keys.py, which
# explains why they are inert -- but inert or not, a service_role-shaped JWT
# does not enter this repository's history, and preflight's `added secrets`
# gate would refuse it anyway.
smoke/service_role_bundle/keys.rotation.env
smoke/service_role_bundle/dist_key_a/
smoke/service_role_bundle/dist_key_b/
smoke/service_role_bundle/dist_clean/
