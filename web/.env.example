# Drydock web frontend — environment (all client-side, hence NEXT_PUBLIC_*).
# Copy to .env.local for local dev. On Vercel, set these in the project's
# Environment Variables.

# Base URL of the live FastAPI backend this frontend calls. Defaults in
# code to the production VPS, so a plain `npm run dev` talks to the real
# backend out of the box. Override to point at a local backend, e.g.
# http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL=https://45-10-40-169.sslip.io

# Telegram bot username (WITHOUT the leading @) for the Stars payment
# deep link, i.e. https://t.me/<username>. The backend code does not
# hardcode a bot username anywhere, so you MUST set your real bot's
# username here — the Pay-with-Stars button links to it. Left blank, the
# UI shows the button as unconfigured rather than guessing a fake handle.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# PayPal JS SDK client id (the PUBLIC half of the backend's PAYPAL_CLIENT_ID).
# The PayPal buttons load the SDK with this and open orders/subscriptions
# against the backend. Left blank, the PayPal cards render as "unconfigured"
# instead of loading the SDK, exactly like the Stars button above. The PayPal
# SECRET is backend-only and never appears here.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
