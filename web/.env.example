# Drydock web frontend — environment (all client-side, hence NEXT_PUBLIC_*).
# Copy to .env.local for local dev. On Vercel, set these in the project's
# Environment Variables.

# Base URL of the FastAPI backend. The code fallback is http://localhost:8000;
# this example explicitly selects production. For local development, set the
# local API URL instead, e.g. http://127.0.0.1:8000.
NEXT_PUBLIC_API_BASE_URL=https://api.drydock.co

# Bot links and payment availability come from the backend API. Configure
# TELEGRAM_BOT_USERNAME there. Legacy NEXT_PUBLIC_TELEGRAM_BOT_USERNAME and
# NEXT_PUBLIC_PAYPAL_CLIENT_ID are not read by the current frontend.
