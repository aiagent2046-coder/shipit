import requests
from fastapi import FastAPI, HTTPException
from pydantic import BaseModel

app = FastAPI()

class FetchRequest(BaseModel):
    target: str
    replacement: str
    label: str = 'fetch'

@app.post('/fetch')
def fetch(payload: FetchRequest):
    if payload.target not in {'https://api.example.test/status'}:
        raise HTTPException(status_code=400, detail='Unsupported destination')
    payload.target = payload.replacement
    response = requests.get(payload.target, timeout=2)
    return {'status': response.status_code, 'label': payload.label}
