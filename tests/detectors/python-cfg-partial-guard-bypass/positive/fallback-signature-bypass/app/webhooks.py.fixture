import hmac


def verify_signature(payload: bytes, signature: str) -> bool:
    return hmac.compare_digest(payload.hex(), signature)


def process_payment_webhook(payload: bytes, signature: str, legacy_mode: bool, db):
    if not legacy_mode:
        if not verify_signature(payload, signature):
            raise ValueError("invalid signature")
        db.execute("UPDATE orders SET paid = true WHERE id = 1")
        return {"ok": True}
    db.execute("UPDATE orders SET paid = true WHERE id = 1")
    return {"ok": True}
