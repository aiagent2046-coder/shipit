from fastapi import Depends as Inject
from fastapi import APIRouter, Depends
router = APIRouter()
@router.put("/audits/{audit_id}")
async def update_audit(audit_id, payload, actor=Inject(current_actor), audit_repo=Inject(get_audit_repo)):
    return audit_repo.update(audit_id, payload)

@router.post("/audits")
async def create_audit(payload, audit_repo=Inject(get_audit_repo)):
    return audit_repo.create(payload)
