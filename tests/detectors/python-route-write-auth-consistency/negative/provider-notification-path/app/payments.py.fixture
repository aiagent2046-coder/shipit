from fastapi import APIRouter, Depends

router = APIRouter()


@router.put("/payments/{payment_id}")
async def update_payment(payment_id, payload, admin=Depends(get_admin), payment_repo=Depends(get_payment_repo)):
    return payment_repo.update(payment_id, payload)


@router.post("/payments/notifications")
async def notification(payload, payment_repo=Depends(get_payment_repo)):
    return payment_repo.create(payload)
