from fastapi import APIRouter, Depends

router = APIRouter()


@router.put("/audits/{audit_id}")
async def update_audit(audit_id, payload, guard=Depends(get_auth_service), audit_repo=Depends(get_audit_repo)):
    return audit_repo.update(audit_id, payload)


@router.post("/audits")
async def create_audit(payload, guard=Depends(get_auth_service), audit_repo=Depends(get_audit_repo)):
    return audit_repo.create(payload)
