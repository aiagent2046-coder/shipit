from fastapi import APIRouter, Depends

router = APIRouter()


@router.put("/records/{record_id}")
async def edit_record(record_id, payload, actor=Depends(current_actor), record_repo=Depends(get_record_repo)):
    return record_repo.update(record_id, payload)


@router.post("/reports/preview")
async def preview(payload, record_repo=Depends(get_record_repo)):
    return record_repo.render(payload)
