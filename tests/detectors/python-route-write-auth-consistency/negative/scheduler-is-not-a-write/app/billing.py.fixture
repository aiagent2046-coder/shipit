from fastapi import APIRouter, BackgroundTasks, Depends

router = APIRouter()


@router.put("/billing/{payment_id}")
async def confirm_payment(payment_id, payload, admin=Depends(get_admin), payment_repo=Depends(get_payment_repo)):
    return payment_repo.update(payment_id, payload)


@router.post("/billing/charge")
async def charge(payload, background: BackgroundTasks, payment_repo=Depends(get_payment_repo)):
    background.add_task(payment_repo.settle, payload)
    return {"ok": True}
