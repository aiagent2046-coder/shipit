[importlinter]
root_packages =
    app

# deslop-please `module-cycle` analogue: siblings under `app` must not use
# each other in a circle (import-linter 2.17 `acyclic_siblings`).
# Methodology: fix from first principles -- what is the intended layer of
# abstraction? Which module belongs at which layer?
#
# Baseline (2026-11-25): the 30 cycle edges measured on main are listed in
# ignore_imports below, so the CI gate fails on NEW cycles only. This is the
# `--update-allow` ratchet pattern: known debt is tracked, new debt fails.
# When an edge here is actually untangled, its entry becomes unmatched and
# (unmatched_ignore_imports_alerting=error, the default) the lint asks for
# the entry to be removed. Do not add new entries without untangling the
# cycle from first principles.
#
# Fix phase progress: 3 of 30 untangled from first principles and REMOVED
# from this baseline (app.fixpack.verified_build -> app.fixpack.semantic_check
# via the new gate composition layer; app.sca.lockfiles -> app.sca.bun_lock
# and app.sca.resolved_locks -> app.sca.lockfiles via the new
# lockfile_primitives bottom layer). 27 remain.
[importlinter:contract:siblings-acyclic]
name = siblings-acyclic
type = acyclic_siblings
ancestors =
    app
broken_contract_guidance = Fix from first principles: what is the intended layer of abstraction? Which module belongs at which layer? Do not do mechanical moves just to hide the cycle.
ignore_imports =
    app.alerts -> app.notify.telegram
    app.audit_history -> app.sca.refresh
    app.audit_history -> app.sca.snapshot
    app.deploypack.paid_delivery_auth -> app.routes._shared
    app.ingest.stack_detect -> app.scan.file_scope
    app.mcp.server -> app.main
    app.mcp.server -> app.routes.dependencies
    app.ops_endpoints -> app.db
    app.sandbox_client -> app.deploypack.sandbox
    app.sandbox_client -> app.fixpack.semantic_check
    app.sandbox_client -> app.fixpack.verification
    app.sandbox_client -> app.proof.types
    app.scan.browser -> app.report.sarif
    app.scan.cve_match -> app.sca.lockfiles
    app.scan.ghsa_catalog -> app.sca.lockfiles
    app.scan.manifest -> app.sca.lockfiles
    app.scan.pipeline -> app.fixpack.generate
    app.scan.pipeline -> app.sca.osv
    app.scan.pipeline -> app.sca.snapshot
    app.scan.pipeline -> app.sca.stage
    app.scan.static -> app.report.plain_language
    app.scan.atomic_claims -> app.scan.syntax_claims
    app.scan.external_operation_context -> app.scan.external_call_assessment
    app.scan.projected_read_identity -> app.scan.issue_identity
    app.scan.remediation_catalog -> app.scan.cve_match
    app.scan.rls_recommendations -> app.scan.recommendations
    app.scan.url_token_assessment -> app.scan.auth_source_assessment
